{
  "expo": {
    "name": "Pacific Elite Rides",
    "slug": "per-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.pacificeliterides.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tel",
          "sms",
          "mailto"
        ]
      }
    },
    "android": {
      "package": "com.pacificeliterides.app",
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Pacific Elite Rides adds your booked ride to your calendar when you tap Add to Calendar."
        }
      ]
    ],
    "scheme": "pacificeliterides",
    "owner": "berdnikovandriis-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "805e0efc-e6e3-49b4-bf7e-18703c79bb31"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/805e0efc-e6e3-49b4-bf7e-18703c79bb31"
    }
  }
}
